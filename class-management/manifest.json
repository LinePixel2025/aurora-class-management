{
  "id": "com.classmanagement.board",
  "name": "班级事务台",
  "version": "2.0.0",
  "apiVersion": 1,
  "minAuroraVersion": "0.5.2",
  "description": "2 张桌面浮窗（桌面层 + 亚克力）显示班级速览与今日事务；2 个面板（今日管理台 + 页面型班级周历）与 3 条斜杠命令；12 个 Agent 工具；可选系统通知。",
  "author": {
    "name": "LinePixel2025"
  },
  "license": "MIT",
  "homepage": "https://github.com/LinePixel2025/aurora-class-management",
  "main": "main.js",
  "activation": "startup",
  "permissions": [
    "tools",
    "skills",
    "commands",
    "storage",
    "config",
    "logging",
    "ui.panels",
    "ui.widgets",
    "notifications"
  ],
  "contributes": {
    "tools": [
      {
        "name": "get_overview",
        "description": "读取某一天及所在周的班级总览：班级信息、周次、值日组与成员、该日事务（含 id）、本周安排与通知。默认今天；给 weekOffset 时事务默认该周周一。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移：0=本周，1=下周，-1=上周"
            },
            "includeDone": {
              "type": "boolean",
              "description": "是否在事务清单中包含已完成项，默认 true"
            },
            "date": {
              "type": "string",
              "description": "事务日期 YYYY-MM-DD，默认今天；可查最近 7 天历史或未来 ±12 周"
            }
          }
        },
        "sensitivity": "safe",
        "readonly": true,
        "timeoutMs": 30000
      },
      {
        "name": "list_tasks",
        "description": "列出某一天的事务，默认今天；返回每条事务的 id、内容、完成状态、截止日期/时间、优先级、分类与负责人。",
        "parameters": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "done",
                "all"
              ],
              "description": "筛选状态，默认 pending"
            },
            "category": {
              "type": "string",
              "description": "只看某个分类（作业 / 活动 / 通知 / 事务 / 其他）"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "最多返回多少条，默认 30"
            },
            "date": {
              "type": "string",
              "description": "事务日期 YYYY-MM-DD，默认今天；可查最近 7 天历史或未来 ±12 周"
            }
          }
        },
        "sensitivity": "safe",
        "readonly": true,
        "timeoutMs": 30000
      },
      {
        "name": "add_task",
        "description": "给某一天添加一条班级事务（默认今天）；写入后桌面浮窗与面板会即时刷新。事务按天管理，不能早于今天。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "事务内容，例如：收物理作业"
            },
            "dueDate": {
              "type": "string",
              "description": "截止日期，格式 YYYY-MM-DD（可选）"
            },
            "dueTime": {
              "type": "string",
              "description": "截止时间，格式 HH:mm（可选）"
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "normal",
                "low"
              ],
              "description": "优先级，默认 normal"
            },
            "category": {
              "type": "string",
              "description": "分类，例如：作业 / 活动 / 通知 / 事务 / 其他，默认「事务」"
            },
            "assignee": {
              "type": "string",
              "description": "负责人（可选）"
            },
            "date": {
              "type": "string",
              "description": "事务所属日期 YYYY-MM-DD，默认今天；不能早于今天，最远 +12 周"
            }
          },
          "required": [
            "text"
          ]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "update_task",
        "description": "按 id 修改一条事务的任意字段（内容、截止日期/时间、优先级、分类、负责人、完成状态）。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "事务 id（由 get_overview / list_tasks 返回）"
            },
            "text": {
              "type": "string",
              "description": "新内容"
            },
            "dueDate": {
              "type": "string",
              "description": "新截止日期 YYYY-MM-DD，空字符串表示清除"
            },
            "dueTime": {
              "type": "string",
              "description": "新截止时间 HH:mm，空字符串表示清除"
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "normal",
                "low"
              ]
            },
            "category": {
              "type": "string"
            },
            "assignee": {
              "type": "string",
              "description": "负责人，空字符串表示清除"
            },
            "done": {
              "type": "boolean",
              "description": "完成状态"
            }
          },
          "required": [
            "id"
          ]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "complete_task",
        "description": "把一条事务标记完成或撤销完成。优先用 id；也可以给 text + date（默认今天），文本必须当天唯一命中。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "事务 id（可选）"
            },
            "text": {
              "type": "string",
              "description": "事务内容片段，必须唯一命中（可选）"
            },
            "done": {
              "type": "boolean",
              "description": "true=完成，false=撤销完成，默认 true"
            },
            "date": {
              "type": "string",
              "description": "文本匹配所在日期 YYYY-MM-DD，默认今天；可查最近 7 天历史"
            }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "delete_task",
        "description": "删除一条事务。优先用 id；也可以给 text + date（默认今天），文本必须当天唯一命中。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "事务 id（可选）"
            },
            "text": {
              "type": "string",
              "description": "事务内容片段，必须唯一命中（可选）"
            },
            "date": {
              "type": "string",
              "description": "文本匹配所在日期 YYYY-MM-DD，默认今天；可查最近 7 天历史"
            }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_duty_week",
        "description": "设置某个周由哪个值日组负责（整周一组），并写入本周值日备注；groupName 传空字符串或 clear=true 可恢复自动轮换。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "groupName": {
              "type": "string",
              "description": "值日组名称或 id，例如：第2组"
            },
            "note": {
              "type": "string",
              "description": "本周值日备注"
            },
            "clear": {
              "type": "boolean",
              "description": "清除本周指定组，恢复自动轮换"
            }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_duty_groups",
        "description": "设置值日分组与按周轮换顺序。groups 每项包含组名与成员；order 是按周轮换的组名顺序（可省略，默认按 groups 顺序）。",
        "parameters": {
          "type": "object",
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "组名，例如：第1组"
                  },
                  "members": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "成员姓名列表"
                  }
                },
                "required": [
                  "name",
                  "members"
                ]
              },
              "description": "1–8 个值日组"
            },
            "order": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "按周轮换的组名顺序，例如 [\"第1组\",\"第2组\",\"第3组\",\"第4组\"]"
            }
          },
          "required": [
            "groups"
          ]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "add_schedule",
        "description": "给某个周添加一条安排（班会、活动、考试等），包含周几、时间、事项与地点。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "周几：1=周一 … 7=周日"
            },
            "title": {
              "type": "string",
              "description": "事项，例如：班会"
            },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "time": {
              "type": "string",
              "description": "时间 HH:mm（可选）"
            },
            "place": {
              "type": "string",
              "description": "地点（可选）"
            },
            "note": {
              "type": "string",
              "description": "备注（可选）"
            }
          },
          "required": [
            "weekday",
            "title"
          ]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "delete_schedule",
        "description": "删除一条本周安排。优先用 id；也可以给 weekday + title，标题必须在当天唯一命中。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "id": {
              "type": "string",
              "description": "安排 id（可选）"
            },
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "周几（与 title 配合使用）"
            },
            "title": {
              "type": "string",
              "description": "事项名称（与 weekday 配合使用）"
            }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_announcement",
        "description": "设置某个周的班级通知；text 传空字符串表示清除通知。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "通知内容，最多 600 字"
            },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            }
          },
          "required": [
            "text"
          ]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "apply_week_plan",
        "description": "一次写入整周计划：tasks（按 date 落到目标周某天）、schedule、duty（groupName/note，整周一组）、announcement。原子写入，只推送一次刷新；replaceTasks/replaceSchedule=true 时先清空目标周数据。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "plan": {
              "type": "object",
              "description": "整周计划",
              "properties": {
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "dueDate": {
                        "type": "string",
                        "description": "YYYY-MM-DD"
                      },
                      "dueTime": {
                        "type": "string",
                        "description": "HH:mm"
                      },
                      "priority": {
                        "type": "string",
                        "enum": [
                          "high",
                          "normal",
                          "low"
                        ]
                      },
                      "category": {
                        "type": "string"
                      },
                      "assignee": {
                        "type": "string"
                      },
                      "date": {
                        "type": "string",
                        "description": "任务日期 YYYY-MM-DD，必须在目标周内；默认本周为今天、其他周为该周周一"
                      }
                    },
                    "required": [
                      "text"
                    ]
                  }
                },
                "schedule": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "weekday": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      },
                      "time": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "place": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "weekday",
                      "title"
                    ]
                  }
                },
                "duty": {
                  "type": "object",
                  "properties": {
                    "groupName": {
                      "type": "string",
                      "description": "本周轮换组名"
                    },
                    "note": {
                      "type": "string",
                      "description": "本周值日备注"
                    }
                  }
                },
                "announcement": {
                  "type": "string",
                  "description": "班级通知，空字符串清除"
                },
                "replaceTasks": {
                  "type": "boolean",
                  "description": "先清空目标周全部事务再写入"
                },
                "replaceSchedule": {
                  "type": "boolean",
                  "description": "先清空本周安排再写入"
                }
              }
            }
          },
          "required": [
            "plan"
          ]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 60000
      }
    ],
    "skills": [
      "skills/class-board"
    ],
    "commands": [
      {
        "name": "class",
        "title": "打开班级事务台",
        "description": "在右栏打开班级事务台，查看今日事务、本周值日、安排与通知",
        "mode": "action"
      },
      {
        "name": "week-plan",
        "title": "总结今日班级计划",
        "description": "让 Agent 读取今日数据并用三条要点总结今天要做什么",
        "mode": "prompt"
      },
      {
        "name": "calendar",
        "title": "打开班级周历",
        "description": "在右栏打开班级周历，按天查看和编辑事务、安排与值日",
        "mode": "action"
      }
    ],
    "panels": [
      {
        "id": "board",
        "title": "班级事务台",
        "icon": "CalendarClock",
        "schema": "ui/panel.json"
      },
      {
        "id": "calendar",
        "title": "班级周历",
        "icon": "CalendarClock",
        "entry": "ui/calendar.html"
      }
    ],
    "widgets": [
      {
        "id": "week-overview",
        "title": "班级速览",
        "icon": "Gauge",
        "slot": "desktop",
        "windowLevel": "desktop",
        "windowMaterial": "acrylic",
        "schema": "ui/widget-overview.json",
        "defaultSize": {
          "width": 320,
          "height": 300
        }
      },
      {
        "id": "week-tasks",
        "title": "今日事务",
        "icon": "ListChecks",
        "slot": "desktop",
        "windowLevel": "desktop",
        "windowMaterial": "acrylic",
        "schema": "ui/widget-tasks.json",
        "defaultSize": {
          "width": 360,
          "height": 460
        }
      }
    ]
  },
  "config": {
    "fields": [
      {
        "key": "className",
        "label": "班级名称",
        "type": "text",
        "description": "显示在管理台与班级速览浮窗上",
        "default": "我的班级",
        "placeholder": "例如：高二(15)班"
      },
      {
        "key": "teacher",
        "label": "班主任",
        "type": "text",
        "description": "显示在管理台与班级速览浮窗上（可留空）",
        "default": ""
      },
      {
        "key": "termStartDate",
        "label": "学期起始日期",
        "type": "text",
        "description": "本学期第 1 周的周一，格式 YYYY-MM-DD；留空则以首次运行所在周为第 1 周",
        "default": "",
        "placeholder": "2026-09-01"
      },
      {
        "key": "showCompleted",
        "label": "浮窗显示已完成事务",
        "type": "boolean",
        "description": "打开后「今日事务」浮窗会同时显示今天已完成的事务",
        "default": false
      },
      {
        "key": "notifyDaily",
        "label": "每日简报",
        "type": "boolean",
        "description": "每天在提醒时间发送今日事务与本周值日摘要",
        "default": false
      },
      {
        "key": "notifyTime",
        "label": "提醒时间",
        "type": "text",
        "description": "本地时间 HH:mm；每日简报与周一值日提醒使用",
        "default": "07:30",
        "placeholder": "07:30"
      },
      {
        "key": "notifyDue",
        "label": "截止提醒",
        "type": "boolean",
        "description": "今天的事务在截止前提醒",
        "default": false
      },
      {
        "key": "notifyDueLead",
        "label": "提前分钟",
        "type": "number",
        "description": "截止前多少分钟提醒",
        "default": 10,
        "min": 0,
        "max": 120,
        "step": 5
      },
      {
        "key": "notifyDuty",
        "label": "周一值日提醒",
        "type": "boolean",
        "description": "每周一在提醒时间发送本周值日组",
        "default": false
      }
    ]
  }
}

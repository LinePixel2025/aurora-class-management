{
  "id": "com.classmanagement.board",
  "name": "班级事务台",
  "version": "1.0.0",
  "apiVersion": 1,
  "minAuroraVersion": "0.5.1",
  "description": "桌面置顶浮窗显示本周值日、本周事务、本周安排与班级速览，并提供右栏管理台与一整套 Agent 工具。",
  "author": { "name": "LinePixel2025" },
  "license": "MIT",
  "homepage": "https://github.com/LinePixel2025/aurora-class-management",
  "main": "main.js",
  "activation": "startup",
  "permissions": [
    "tools",
    "skills",
    "commands",
    "storage",
    "config",
    "logging",
    "ui.panels",
    "ui.widgets"
  ],
  "contributes": {
    "tools": [
      {
        "name": "get_overview",
        "description": "读取某个周（默认本周）的班级事务总览：班级信息、第几周与日期范围、值日安排、事务清单（含 id）、本周安排与通知。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移：0=本周，1=下周，-1=上周"
            },
            "includeDone": {
              "type": "boolean",
              "description": "是否在事务清单中包含已完成项，默认 true"
            }
          }
        },
        "sensitivity": "safe",
        "readonly": true,
        "timeoutMs": 30000
      },
      {
        "name": "list_tasks",
        "description": "列出某个周的事务，返回每条事务的 id、内容、完成状态、截止日期/时间、优先级、分类与负责人。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "done", "all"],
              "description": "筛选状态，默认 pending"
            },
            "category": {
              "type": "string",
              "description": "只看某个分类（作业 / 活动 / 通知 / 事务 / 其他）"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "description": "最多返回多少条，默认 30"
            }
          }
        },
        "sensitivity": "safe",
        "readonly": true,
        "timeoutMs": 30000
      },
      {
        "name": "add_task",
        "description": "给某个周添加一条班级事务（作业/活动/通知等）。写入后桌面浮窗与面板会即时刷新。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "description": "事务内容，例如：收物理作业" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "放到哪一周，默认 0（本周）；给了 dueDate 且没给 weekOffset 时按截止日期所在周归档"
            },
            "dueDate": { "type": "string", "description": "截止日期，格式 YYYY-MM-DD（可选）" },
            "dueTime": { "type": "string", "description": "截止时间，格式 HH:mm（可选）" },
            "priority": {
              "type": "string",
              "enum": ["high", "normal", "low"],
              "description": "优先级，默认 normal"
            },
            "category": {
              "type": "string",
              "description": "分类，例如：作业 / 活动 / 通知 / 事务 / 其他，默认「事务」"
            },
            "assignee": { "type": "string", "description": "负责人（可选）" }
          },
          "required": ["text"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "update_task",
        "description": "按 id 修改一条事务的任意字段（内容、截止日期/时间、优先级、分类、负责人、完成状态）。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "事务 id（由 get_overview / list_tasks 返回）" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "事务所在周，默认 0"
            },
            "text": { "type": "string", "description": "新内容" },
            "dueDate": { "type": "string", "description": "新截止日期 YYYY-MM-DD，空字符串表示清除" },
            "dueTime": { "type": "string", "description": "新截止时间 HH:mm，空字符串表示清除" },
            "priority": { "type": "string", "enum": ["high", "normal", "low"] },
            "category": { "type": "string" },
            "assignee": { "type": "string", "description": "负责人，空字符串表示清除" },
            "done": { "type": "boolean", "description": "完成状态" }
          },
          "required": ["id"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "complete_task",
        "description": "把一条事务标记完成或撤销完成。优先用 id；也可以给 text，但文本必须在本周唯一命中。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "事务 id（可选）" },
            "text": { "type": "string", "description": "事务内容片段，必须唯一命中（可选）" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "事务所在周，默认 0"
            },
            "done": { "type": "boolean", "description": "true=完成，false=撤销完成，默认 true" }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "delete_task",
        "description": "删除一条事务。优先用 id；也可以给 text，但文本必须在本周唯一命中。",
        "parameters": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "事务 id（可选）" },
            "text": { "type": "string", "description": "事务内容片段，必须唯一命中（可选）" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "事务所在周，默认 0"
            }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_duty_day",
        "description": "设置某个周某一天的值日：名单、区域、备注；clear=true 时清除该天覆盖、沿用值日组。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "周几：1=周一 … 7=周日"
            },
            "names": {
              "type": "array",
              "items": { "type": "string" },
              "description": "值日同学姓名列表；空数组表示沿用值日组"
            },
            "area": { "type": "string", "description": "值日区域，例如：教室 / 走廊" },
            "note": { "type": "string", "description": "备注，例如：大扫除" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "clear": { "type": "boolean", "description": "清除该天覆盖，默认 false" }
          },
          "required": ["weekday"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_duty_week",
        "description": "设置某个周由哪个值日组轮值，并写入本周值日备注；groupName 传空字符串或 clear=true 可恢复自动轮换。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "groupName": { "type": "string", "description": "值日组名称或 id，例如：第2组" },
            "note": { "type": "string", "description": "本周值日备注" },
            "clear": { "type": "boolean", "description": "清除本周指定组，恢复自动轮换" }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_duty_groups",
        "description": "设置值日分组与轮换顺序。groups 每项包含组名与成员；order 是按周轮换的组名顺序（可省略，默认按 groups 顺序）。",
        "parameters": {
          "type": "object",
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "description": "组名，例如：第1组" },
                  "members": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "成员姓名列表"
                  }
                },
                "required": ["name", "members"]
              },
              "description": "1–8 个值日组"
            },
            "order": {
              "type": "array",
              "items": { "type": "string" },
              "description": "按周轮换的组名顺序，例如 [\"第1组\",\"第2组\",\"第3组\",\"第4组\"]"
            }
          },
          "required": ["groups"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "add_schedule",
        "description": "给某个周添加一条安排（班会、活动、考试等），包含周几、时间、事项与地点。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "周几：1=周一 … 7=周日"
            },
            "title": { "type": "string", "description": "事项，例如：班会" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "time": { "type": "string", "description": "时间 HH:mm（可选）" },
            "place": { "type": "string", "description": "地点（可选）" },
            "note": { "type": "string", "description": "备注（可选）" }
          },
          "required": ["weekday", "title"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "delete_schedule",
        "description": "删除一条本周安排。优先用 id；也可以给 weekday + title，标题必须在当天唯一命中。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "id": { "type": "string", "description": "安排 id（可选）" },
            "weekday": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7,
              "description": "周几（与 title 配合使用）"
            },
            "title": { "type": "string", "description": "事项名称（与 weekday 配合使用）" }
          }
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "set_announcement",
        "description": "设置某个周的班级通知；text 传空字符串表示清除通知。",
        "parameters": {
          "type": "object",
          "properties": {
            "text": { "type": "string", "description": "通知内容，最多 600 字" },
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            }
          },
          "required": ["text"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 30000
      },
      {
        "name": "apply_week_plan",
        "description": "一次写入整周计划：tasks 事务数组、schedule 安排数组、duty 值日（days 按周几、groupName、note）、announcement 通知。原子写入，只推送一次刷新；replaceTasks/replaceSchedule=true 时先清空再写入。",
        "parameters": {
          "type": "object",
          "properties": {
            "weekOffset": {
              "type": "integer",
              "minimum": -12,
              "maximum": 12,
              "description": "相对本周的周偏移，默认 0"
            },
            "plan": {
              "type": "object",
              "description": "整周计划",
              "properties": {
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": { "type": "string" },
                      "dueDate": { "type": "string", "description": "YYYY-MM-DD" },
                      "dueTime": { "type": "string", "description": "HH:mm" },
                      "priority": { "type": "string", "enum": ["high", "normal", "low"] },
                      "category": { "type": "string" },
                      "assignee": { "type": "string" }
                    },
                    "required": ["text"]
                  }
                },
                "schedule": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
                      "time": { "type": "string" },
                      "title": { "type": "string" },
                      "place": { "type": "string" },
                      "note": { "type": "string" }
                    },
                    "required": ["weekday", "title"]
                  }
                },
                "duty": {
                  "type": "object",
                  "properties": {
                    "days": {
                      "type": "object",
                      "description": "键为周几（1–7），值为 { names: string[], area?, note? }；names 为空数组表示沿用值日组"
                    },
                    "groupName": { "type": "string", "description": "本周轮换组名" },
                    "note": { "type": "string", "description": "本周值日备注" }
                  }
                },
                "announcement": { "type": "string", "description": "班级通知，空字符串清除" },
                "replaceTasks": { "type": "boolean", "description": "先清空本周事务再写入" },
                "replaceSchedule": { "type": "boolean", "description": "先清空本周安排再写入" }
              }
            }
          },
          "required": ["plan"]
        },
        "sensitivity": "confirm",
        "readonly": false,
        "timeoutMs": 60000
      }
    ],
    "skills": ["skills/class-board"],
    "commands": [
      {
        "name": "class",
        "title": "打开班级事务台",
        "description": "在右栏打开班级事务台，查看本周值日、事务、安排与通知",
        "mode": "action"
      },
      {
        "name": "week-plan",
        "title": "总结本周班级计划",
        "description": "让 Agent 读取本周数据并用三条要点总结今天要做什么",
        "mode": "prompt"
      }
    ],
    "panels": [
      {
        "id": "board",
        "title": "班级事务台",
        "icon": "CalendarClock",
        "schema": "ui/panel.json"
      }
    ],
    "widgets": [
      {
        "id": "duty-week",
        "title": "本周值日",
        "icon": "CalendarClock",
        "slot": "desktop",
        "schema": "ui/widget-duty.json",
        "defaultSize": { "width": 320, "height": 340 }
      },
      {
        "id": "week-tasks",
        "title": "本周事务",
        "icon": "ListChecks",
        "slot": "desktop",
        "schema": "ui/widget-tasks.json",
        "defaultSize": { "width": 360, "height": 420 }
      },
      {
        "id": "week-schedule",
        "title": "本周安排",
        "icon": "Clock",
        "slot": "desktop",
        "schema": "ui/widget-schedule.json",
        "defaultSize": { "width": 320, "height": 300 }
      },
      {
        "id": "week-overview",
        "title": "班级速览",
        "icon": "Gauge",
        "slot": "desktop",
        "schema": "ui/widget-overview.json",
        "defaultSize": { "width": 300, "height": 320 }
      }
    ]
  },
  "config": {
    "fields": [
      {
        "key": "className",
        "label": "班级名称",
        "type": "text",
        "description": "显示在管理台与班级速览浮窗上",
        "default": "我的班级",
        "placeholder": "例如：高二(15)班"
      },
      {
        "key": "teacher",
        "label": "班主任",
        "type": "text",
        "description": "显示在管理台与班级速览浮窗上（可留空）",
        "default": ""
      },
      {
        "key": "termStartDate",
        "label": "学期起始日期",
        "type": "text",
        "description": "本学期第 1 周的周一，格式 YYYY-MM-DD；留空则以首次运行所在周为第 1 周",
        "default": "",
        "placeholder": "2026-09-01"
      },
      {
        "key": "showCompleted",
        "label": "浮窗显示已完成事务",
        "type": "boolean",
        "description": "打开后「本周事务」浮窗会同时显示已完成项",
        "default": false
      }
    ]
  }
}
